# Kabangutsi settings. Copy to .env (never commit .env). Every value has a working default.

# ---------- PostgreSQL ----------
POSTGRES_USER=kabangutsi
POSTGRES_PASSWORD=kabangutsi_dev
POSTGRES_DB=kabangutsi
# For running the backend / alembic on the host (outside Docker):
DATABASE_URL=postgresql+asyncpg://kabangutsi:kabangutsi_dev@localhost:5432/kabangutsi

# ---------- Models (Ollama) ----------
# The user picks a model per session; the router switches only when a capability is missing.
# Team decision 2026-10-31:
#   gemma:2b   = default for normal chat turns (fast, text only)
#   gemma4:e4b = images and audio (via the capability auto-switch) and hard tasks (HARD_TASK_MODEL)
#   gemma4:e2b = optional, used if pulled later
DEFAULT_MODEL=gemma:2b
# Model for hard tasks, whatever the user picked: handoff summary, agent-assist suggestions,
# document field extraction, and the retry when the default model returns invalid intent JSON or low confidence.
HARD_TASK_MODEL=gemma4:e4b
# Auto-switch order when the chosen model lacks a capability (image → vision, audio → audio): first installed match wins
MODEL_PREFERENCE=gemma4:e4b,gemma4:e2b,gemma:2b
EMBED_MODEL=nomic-embed-text
# Models pulled by scripts/pull_models.sh
PULL_MODELS=gemma4:e4b,gemma:2b,nomic-embed-text
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=2

# ---------- Conversation policy (used by the backend in code) ----------
CONFIDENCE_THRESHOLD=0.5
FRUSTRATION_THRESHOLD=0.7
MAX_IDENTITY_ATTEMPTS=3
DEFAULT_LANG=fr
AGENT_DASHBOARD_LANG=fr
TZ_LOCAL=Africa/Bujumbura

# ---------- Service URLs (inside the Docker network) ----------
OLLAMA_URL=http://ollama:11434
VOICE_URL=http://voice:8001
OCR_URL=http://ocr:8002
SMS_GATEWAY_URL=http://sms-gateway:8003
WHATSAPP_BRIDGE_URL=http://whatsapp-bridge:8004
BACKEND_URL=http://backend:8000

# Browser origins allowed by the backend (Flutter web dev server, nginx)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ---------- Host ports ----------
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=8080
VOICE_HOST_PORT=8001
OCR_HOST_PORT=8002
SMS_HOST_PORT=8003
WHATSAPP_HOST_PORT=8004
POSTGRES_HOST_PORT=5432
# 11435 because a host Ollama usually already uses 11434
OLLAMA_HOST_PORT=11435

# ---------- Hardware ----------
MODEM_DEVICE=/dev/ttyUSB0
